# Production tuning for sm75 NVLink pair (see docs: STRATA_X1_BYPASS).
GGML_CUDA_P2P=1
STRATA_SPLIT_OWN_BUFFERS=1
STRATA_PCIE_FRAC_DEFAULT=old

# sm75 Turing decode/prefill kernel tweaks (+3.4-5.0% decode, +4.2% prompt path per lingdeng ab 2026-10-24).
STRATA_SM75_PERF=1
STRATA_X1_BYPASS=1
STRATA_NVLINK_STAGE=1
STRATA_EXPDEC=1
STRATA_SELECT_SIMT=1
STRATA_QSA_ROWS=1
STRATA_BF16_TC=1

# PR #6001 prompt helper: opt-in NVLink P2P + first/last chunk help.
# Disabled: resident expert RAM + prompt buffers crowd the host RAM.
# Re-enable if we ever have more host RAM or strip --resident-budget-gib 16.
#STRATA_PREFILL_HELP=1
#STRATA_PREFILL_HELP_P2P=1
#STRATA_PREFILL_HELP_FIRST=1
#STRATA_PREFILL_HELP_LAST=1

# PR #6131: full prefill NVLink relay (opt-in; disabled - fork's h2d_expert already does the same path).
#STRATA_LOCAL_PREFILL_RELAY=1

# === sm75 实测解锁候选 ===
# STRATA_EXP_MODE=8: 强制 expert 布局用 Volta mode 8 (SwiGLU + q8_1 fused)
# sm75 默认 mode 4 在大 windows (groups > 30) 自动回 mode 0
# mode 8 不做这个回退, 且 GB10 实测 +11.7% (bitwise 等价)
# lingdeng 备份 0.2.13 实测长上下文 decode +3.5% (2026-11-14)
STRATA_EXP_MODE=8
STRATA_SM70_TABLE=1

# file tier io prefetch - 当前完全没有工作 (budget 0)
STRATA_IO_PF_GATE=1
STRATA_COLD_OVERLAP=4
